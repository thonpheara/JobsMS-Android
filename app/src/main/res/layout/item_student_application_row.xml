<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_page"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Top Line: Opportunity Type Pill + Role Title + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppOppBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/tint_indigo_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:text="🎓 Intern"
                android:textColor="@color/tint_indigo"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Software Engineer Intern"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/tint_amber_bg"
                android:paddingHorizontal="9dp"
                android:paddingVertical="2.5dp"
                android:text="Pending"
                android:textColor="@color/tint_amber"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Second Line: Applied Date + Interview Schedule -->
        <TextView
            android:id="@+id/tvAppDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Applied Nov 20, 2026"
            android:textColor="@color/nav_unselected"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tvAppInterview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="📅 Interview: Nov 25, 10:00 AM"
            android:textColor="@color/tint_indigo"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Reschedule Requested Alert Box -->
        <TextView
            android:id="@+id/tvAppRescheduleAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/tint_amber_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="⚠ Reschedule Requested: Schedule conflict"
            android:textColor="@color/tint_amber"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Candidate Cover Letter Box (Tap to expand full text) -->
        <LinearLayout
            android:id="@+id/boxAppCoverLetter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 COVER LETTER (TAP TO EXPAND)"
                android:textColor="@color/nav_unselected"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppCoverLetter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="I am excited to apply for this position..."
                android:textColor="?attr/colorOnSurface"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Recruiter Evaluation Note Box -->
        <LinearLayout
            android:id="@+id/boxAppCompanyNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:backgroundTint="@color/tint_green_bg"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 INTERNAL EVALUATION NOTE"
                android:textColor="?attr/colorPrimary"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppCompanyNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Strong portfolio in Android development."
                android:textColor="?attr/colorOnSurface"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Bottom Action Chips: Join Meeting + Schedule + CV + Chat + Update Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAppJoinMeeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/tint_green_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="🔗 Join"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAppSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="📅 Schedule"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAppResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="📄 CV"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnAppChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/tint_green_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="💬 Chat"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAppUpdateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/tint_indigo_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Status"
                android:textColor="@color/tint_indigo"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
