<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        DEVELOPMENT ONLY: allows plain HTTP to 10.0.2.2 and any local-network IP.
        Android cannot whitelist IP ranges, so cleartext is enabled globally here.
        Remove this (and use HTTPS) before releasing.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

